@model IEnumerable<EcommerceApp.Models.Product>
@{
    ViewData["Title"] = "Catálogo de Anillos - Brillé";
    var categories = ViewBag.Categories as List<EcommerceApp.Models.Category>;
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        ✨ @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row mb-4 text-center">
    <div class="col-md-12">
        <h2 class="fw-bold text-pink-dark">Colección de Anillos Brillé</h2>
        <p class="text-muted">Anillos de alta calidad a <strong>$35.00</strong>. Envíos por Encomiendas o Personalizados (Sujeto a Términos y Condiciones).</p>
        
        <div class="btn-group mt-2" role="group">
            <a href="@Url.Action("Index")" class="btn btn-outline-pink @(ViewBag.SelectedCategory == null ? "active" : "")">Todos</a>
            @if (categories != null)
            {
                foreach (var cat in categories)
                {
                    <a href="@Url.Action("Index", new { categoryId = cat.Id })" 
                       class="btn btn-outline-pink @(ViewBag.SelectedCategory == cat.Id ? "active" : "")">@cat.Name</a>
                }
            }
        </div>
    </div>
</div>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var item in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm border-0">
                <!-- Enmarcado perfecto de la foto sin recortes -->
                <div class="p-3 bg-light rounded-top d-flex align-items-center justify-content-center" style="height: 280px; overflow: hidden;">
                    <img src="@item.ImageUrl" class="img-fluid rounded" alt="@item.Name" style="max-height: 100%; max-width: 100%; object-fit: contain;">
                </div>

                <div class="card-body d-flex flex-column">
                    <span class="badge bg-light text-dark mb-2 align-self-start border">@item.Category?.Name</span>
                    <h5 class="card-title fw-bold">@item.Name</h5>
                    <p class="card-text text-muted small flex-grow-1">@item.Description</p>
                    
                    <div class="d-flex justify-content-between align-items-center my-2">
                        <span class="fs-4 fw-bold text-pink-dark">$@item.Price</span>
                    </div>

                    <form asp-controller="Home" asp-action="AddToCart" method="post" class="mt-2">
                        <input type="hidden" name="productId" value="@item.Id" />
                        <div class="mb-2">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label small fw-bold mb-0">Seleccionar Talla:</label>
                                <button type="button" class="btn btn-link p-0 text-pink-dark small text-decoration-none fw-bold" data-bs-toggle="modal" data-bs-target="#sizeGuideModal">
                                    📏 ¿Te ayudo con tu talla?
                                </button>
                            </div>
                            <select name="size" class="form-select form-select-sm" required>
                                <option value="">-- Seleccionar Talla --</option>
                                @foreach (var s in item.Sizes)
                                {
                                    if (s.Stock > 0)
                                    {
                                        <option value="@s.SizeNumber">Talla @s.SizeNumber (Stock: @s.Stock un.)</option>
                                    }
                                    else
                                    {
                                        <option value="@s.SizeNumber" disabled>Talla @s.SizeNumber (Agotada)</option>
                                    }
                                }
                            </select>
                        </div>
                        <button type="submit" class="btn btn-pink w-100 btn-sm fw-bold">🛍️ Agregar a la Preorden</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

<!-- Modal Guía Gráfica de Tallas -->
<div class="modal fade" id="sizeGuideModal" tabindex="-1" aria-labelledby="sizeGuideModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-brille-pink">
                <h5 class="modal-title fw-bold text-pink-dark" id="sizeGuideModalLabel">📏 Guía Paso a Paso para Medir tu Talla de Anillo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <p class="text-center text-muted small mb-4">Elige el método que te sea más fácil. Te explicamos paso a paso cómo medir tu dedo o un anillo que ya tengas en casa. ✨</p>
                
                <div class="row g-4">
                    <!-- Opción 1 -->
                    <div class="col-md-4">
                        <div class="card h-100 border-0 bg-light p-3 shadow-sm">
                            <div class="badge bg-pink-dark align-self-start mb-2">Opción 1</div>
                            <h6 class="fw-bold text-pink-dark">🧶 Método del Tira de Papel / Hilo</h6>
                            <ol class="small text-muted ps-3 mb-0">
                                <li class="mb-1">Corta una tira de papel de 1 cm de ancho o usa un hilo.</li>
                                <li class="mb-1">Envuélvelo alrededor del dedo donde usarás el anillo.</li>
                                <li class="mb-1">Marca con un lapicero justo donde se cruzan las dos puntas.</li>
                                <li>Extiende el papel sobre una regla y mide los **milímetros exactos**.</li>
                            </ol>
                        </div>
                    </div>

                    <!-- Opción 2 -->
                    <div class="col-md-4">
                        <div class="card h-100 border-0 bg-light p-3 shadow-sm">
                            <div class="badge bg-pink-dark align-self-start mb-2">Opción 2</div>
                            <h6 class="fw-bold text-pink-dark">⭕ Mide un Anillo Existente</h6>
                            <ol class="small text-muted ps-3 mb-0">
                                <li class="mb-1">Busca un anillo que le quede bien en el mismo dedo.</li>
                                <li class="mb-1">Colócalo sobre una regla plana.</li>
                                <li class="mb-1">Mide únicamente el **espacio interno** de borde a borde.</li>
                                <li>**¡Ojo!** No midas los bordes de metal, solo el centro hueco.</li>
                            </ol>
                        </div>
                    </div>

                    <!-- Opción 3 -->
                    <div class="col-md-4">
                        <div class="card h-100 border-0 bg-light p-3 shadow-sm">
                            <div class="badge bg-pink-dark align-self-start mb-2">Opción 3</div>
                            <h6 class="fw-bold text-pink-dark">🎁 Tips para Anillo Sorpresa</h6>
                            <ul class="small text-muted ps-3 mb-0">
                                <li class="mb-1">Pide prestado disimuladamente un anillo de la persona por unos minutos.</li>
                                <li class="mb-1">Pruébate su anillo en tu propio dedo y marca con un lapicero hasta dónde te llega.</li>
                                <li>Pregunta disimuladamente a un familiar o amiga cercana su talla estimada.</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Tabla de Conversión -->
                <div class="table-responsive mt-4">
                    <h6 class="fw-bold text-center text-pink-dark mb-2">📊 Tabla de Equivalencia de Tallas Brillé</h6>
                    <table class="table table-bordered table-sm text-center align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Talla Brillé</th>
                                <th>Circunferencia (Opción 1)</th>
                                <th>Diámetro Interno (Opción 2)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td><strong class="text-pink-dark">Talla 5</strong></td><td>49.3 mm (4.9 cm)</td><td>15.7 mm (1.57 cm)</td></tr>
                            <tr><td><strong class="text-pink-dark">Talla 6</strong></td><td>51.8 mm (5.1 cm)</td><td>16.5 mm (1.65 cm)</td></tr>
                            <tr><td><strong class="text-pink-dark">Talla 7</strong></td><td>54.4 mm (5.4 cm)</td><td>17.3 mm (1.73 cm)</td></tr>
                            <tr><td><strong class="text-pink-dark">Talla 8</strong></td><td>56.9 mm (5.6 cm)</td><td>18.1 mm (1.81 cm)</td></tr>
                            <tr><td><strong class="text-pink-dark">Talla 9</strong></td><td>59.5 mm (5.9 cm)</td><td>18.9 mm (1.89 cm)</td></tr>
                            <tr><td><strong class="text-pink-dark">Talla 10</strong></td><td>62.1 mm (6.2 cm)</td><td>19.8 mm (1.98 cm)</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-pink btn-sm fw-bold" data-bs-dismiss="modal">¡Entendido, ya sé mi talla! ✨</button>
            </div>
        </div>
    </div>
</div>