@model IEnumerable<EcommerceApp.Models.Customer>
@{
    ViewData["Title"] = "Agenda de Clientes & Historial";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold text-pink-dark mb-0">👥 Agenda de Clientes y Control de Frecuencia</h3>
    <div>
        <a asp-action="Index" class="btn btn-outline-pink me-2">📦 Inventario</a>
        <a asp-action="Orders" class="btn btn-outline-pink">📋 Preordenes</a>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Cliente</th>
                    <th>Contacto</th>
                    <th>Preordenes Totales</th>
                    <th>Total Invertido</th>
                    <th>Estado de Cuenta</th>
                    <th>Acción</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var c in Model)
                    {
                        var totalSpent = c.Orders.Where(o => o.Status != EcommerceApp.Models.OrderStatus.Cancelado).Sum(o => o.Total);
                        <tr>
                            <td>
                                <strong>@c.Name</strong><br />
                                <span class="badge bg-light text-dark border">Cliente Frecuente</span>
                            </td>
                            <td>
                                📲 @c.Phone<br />
                                ✉️ @c.Email
                            </td>
                            <td><span class="badge bg-info text-dark">@c.Orders.Count pedido(s)</span></td>
                            <td class="fw-bold text-pink-dark">$@totalSpent.ToString("F2")</td>
                            <td>
                                @if (c.IsBanned)
                                {
                                    <span class="badge bg-danger">🚫 Suspendido / Baneado</span>
                                    <div class="small text-muted">@c.BanReason</div>
                                }
                                else
                                {
                                    <span class="badge bg-success">✅ Activo</span>
                                }
                            </td>
                            <td>
                                <form asp-action="ToggleBanCustomer" method="post" class="d-flex gap-1">
                                    <input type="hidden" name="id" value="@c.Id" />
                                    @if (c.IsBanned)
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-success">Reactivar</button>
                                    }
                                    else
                                    {
                                        <input type="text" name="banReason" class="form-control form-control-sm" placeholder="Razón baneo" style="width: 120px;" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Suspender</button>
                                    }
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">No hay clientes registrados en la agenda todavía.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>