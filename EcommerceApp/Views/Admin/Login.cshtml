@{
    ViewData["Title"] = "Acceso Admin - Brillé";
}

<div class="row justify-content-center my-5">
    <div class="col-md-4">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 text-center">
                <h4 class="fw-bold text-pink-dark mb-3">⚙️ Acceso Admin Brillé</h4>
                <p class="text-muted small">Ingresa la contraseña para administrar el inventario y validar preordenes.</p>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger py-2 small">@ViewBag.Error</div>
                }

                <form asp-action="Login" method="post">
                    <div class="mb-3">
                        <input type="password" name="password" class="form-control" placeholder="Contraseña de acceso" required />
                    </div>
                    <button type="submit" class="btn btn-pink w-100">Ingresar al Panel</button>
                </form>
                <small class="text-muted d-block mt-3">Clave de acceso: <code>Brille2026</code></small>
            </div>
        </div>
    </div>
</div>